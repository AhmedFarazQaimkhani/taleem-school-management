# PostgreSQL — single shared database, tenant isolation via schoolId
DATABASE_URL="postgresql://taleem:taleem@localhost:5432/taleem?schema=public"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Apex host used to parse tenant subdomains (include port in local dev)
# Production example: yourdomain.com
PLATFORM_DOMAIN="localhost:3000"

# Optional: WhatsApp / Twilio (Phase 1+). Interfaces exist; leave empty for now.
WHATSAPP_TOKEN=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Local logo/file uploads (namespaced /tenants/{schoolId}/...)
UPLOAD_DIR="uploads"

# S3-compatible storage (namespaced /tenants/{schoolId}/...)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# Daily invoice generation. Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET="replace-with-a-long-random-string"
